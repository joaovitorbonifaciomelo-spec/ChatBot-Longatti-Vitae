# ============================================================
#  .env  —  configuração de INFRA/segredos (uma por clínica)
#  Copie para ".env" e ajuste. A personalização de TEXTOS e
#  dados da clínica fica em data/clinica.json (não aqui).
# ============================================================

# Porta do bot. Se rodar VÁRIAS clínicas na mesma VPS, cada uma usa uma porta diferente
# (ex.: 3000, 3001, 3002...).
PORT=3000

# Endereço da Evolution API. Com Docker na mesma rede use o nome do serviço;
# rodando o bot fora do Docker, aponte para http://localhost:8080
EVOLUTION_API_URL=http://localhost:8080

# Chave da Evolution (AUTHENTICATION_API_KEY). A MESMA Evolution pode servir
# várias clínicas; o que muda por clínica é a INSTANCE abaixo.
EVOLUTION_API_KEY=troque-esta-chave

# Nome da instância/numero do WhatsApp desta clínica na Evolution (único por clínica).
EVOLUTION_INSTANCE=longatti

# Senha do PostgreSQL usado pela Evolution (lido pelo docker-compose da Evolution).
POSTGRES_PASSWORD=troque-esta-senha

# Número (com DDI+DDD) da secretária que recebe as notificações e usa o comando #botox.
SECRETARY_NUMBER=5562999999999

# ---- Ajustes de comportamento (podem ficar no padrão) ----
# Tempo (ms) mostrando "digitando…" antes de cada resposta ao cliente.
REPLY_DELAY_MS=4000
# Janela (ms) para agrupar mensagens enviadas em sequência e responder de uma vez.
MESSAGE_GROUP_WINDOW_MS=5000
# Pausa (ms) do bot quando a conversa entra em "atendimento humano" (secretária
# respondeu OU paciente foi transferido). Renovada a cada resposta da secretária.
# Persistida em data/pausas.json. Enquanto pausado o bot fica 100% mudo nessa
# conversa (nem a mensagem de fora de horário sai).
# 3 dias = 259200000 | 30 dias = 2592000000 | 6 meses = 15552000000
TAKEOVER_PAUSE_MS=15552000000
# Após este tempo de inatividade (ms), a conversa recomeça do início (6h = 21600000).
# 0 desliga o reinício automático.
SESSION_RESET_MS=21600000
# Debug temporário: loga o payload bruto do webhook (1 para ligar).
DEBUG_WEBHOOK=0
